# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME=TashiHome
ENV=development
DEBUG=true
PORT=8020
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:4200

# ==============================================================================
# Database Configuration
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tashihome

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==============================================================================
# Rate Limiting & IP Cooldown (Setting-driven, Redis-based)
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_COOLDOWN_SECONDS=3600
RATE_LIMIT_KEY_PREFIX=ratelimit

# HTTP Method-specific Rate Limits (requests per window in seconds)
RATE_LIMIT_GET_MAX_REQUESTS=120
RATE_LIMIT_GET_WINDOW_SECONDS=60

RATE_LIMIT_POST_MAX_REQUESTS=30
RATE_LIMIT_POST_WINDOW_SECONDS=60

RATE_LIMIT_PUT_MAX_REQUESTS=30
RATE_LIMIT_PUT_WINDOW_SECONDS=60

RATE_LIMIT_PATCH_MAX_REQUESTS=30
RATE_LIMIT_PATCH_WINDOW_SECONDS=60

RATE_LIMIT_DELETE_MAX_REQUESTS=20
RATE_LIMIT_DELETE_WINDOW_SECONDS=60

RATE_LIMIT_DEFAULT_MAX_REQUESTS=60
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# ==============================================================================
# Idempotency Key Configuration (Redis-based)
# ==============================================================================
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_EXPIRE_SECONDS=86400
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=30
IDEMPOTENCY_KEY_PREFIX=idempotency
# ==============================================================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=30
ACCOUNT_ACTIVATION_HOURS=24

# ==============================================================================
# Security, CORS & Cookies
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ==============================================================================
# Storage / AWS S3 / MinIO Configuration
# ==============================================================================
S3_PROVIDER=mock
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_USE_SSL=true

# ==============================================================================
# CloudFront Configuration
# ==============================================================================
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=
CLOUDFRONT_COOKIE_DOMAIN=.tashihomes.in
CLOUDFRONT_COOKIE_TTL=3600

# ==============================================================================
# Email Configuration
# Providers: mock, smtp, mailgun, brevo
# ==============================================================================
EMAIL_PROVIDER=mock
EMAILS_FROM_EMAIL=noreply@tashihomes.in
EMAILS_FROM_NAME="Tashi Home"

# SMTP (if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Mailgun (if EMAIL_PROVIDER=mailgun)
MAILGUN_DOMAIN=
MAILGUN_API_KEY=

# Brevo (if EMAIL_PROVIDER=brevo)
BREVO_API_KEY=

# ==============================================================================
# Payments & Razorpay Configuration
# ==============================================================================
PAYMENT_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
DEFAULT_COMMISSION_PERCENTAGE=10.0

# ==============================================================================
# Background Scheduler & Cron Configuration
# ==============================================================================
ENABLE_SCHEDULER=true
PUBLIC_STATS_UPDATE_INTERVAL_MINUTES=15

# ==============================================================================
# Logging & IP Details
# ==============================================================================
LOGIN_LOG_ENABLED=true
IP_DETAILS_API_URL=