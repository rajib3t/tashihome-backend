# App Configuration
APP_NAME=TashiHome Backend
ENV=production
DEBUG=false
LOG_LEVEL=INFO
PORT=8020

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=30

# Frontend URL
FRONTEND_URL=https://www.tashihomes.in

# CORS Configuration - IMPORTANT: Set this in production!
CORS_ALLOWED_ORIGINS=https://www.tashihomes.in,https://tashihomes.in

# Allowed Hosts for TrustedHostMiddleware (leave empty to disable)
ALLOWED_HOSTS=

# Cookie Security
SECURE_COOKIES=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=localhost
# S3 Configuration (Optional)
S3_PROVIDER=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_USE_SSL=true


EMAIL_PROVIDER=smtp

# IF SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=''
SMTP_PASSWORD=''
# IF FROM EMAIL
EMAILS_FROM_EMAIL=info@tashihomes.in
EMAILS_FROM_NAME=${APP_NAME}
# IF MAILGUN
MAILGUN_DOMAIN=
MAILGUN_API_KEY=

# IF BREVO
BREVO_API_KEY=


CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=
CLOUDFRONT_COOKIE_DOMAIN: str = ".tashihomes.in"
CLOUDFRONT_COOKIE_TTL: int = 3600

# Login Log Settings
LOGIN_LOG_ENABLED=true
IP_DETAILS_API_URL=


PAYMENT_ENABLED=
# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=