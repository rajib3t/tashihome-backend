[Unit]
Description=FastAPP (Homestay Backend Web API)
After=network.target redis.service postgresql.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=project-path

ExecStart=project-path/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4

Restart=always
RestartSec=5

Environment="PATH=project-path/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="ENABLE_SCHEDULER=false"

# Log settings
StandardOutput=append:/var/log/homestay.log
StandardError=append:/var/log/homestay-error.log

[Install]
WantedBy=multi-user.target

